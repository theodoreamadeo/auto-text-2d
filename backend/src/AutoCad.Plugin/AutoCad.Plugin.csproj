<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AutoCad.Plugin</RootNamespace>
    <AssemblyName>AutoCad.Plugin</AssemblyName>

    <!-- Override with -p:AutoCadInstallDir=... if AutoCAD is installed somewhere else -->
    <AutoCadInstallDir Condition="'$(AutoCadInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2027\</AutoCadInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced directly from the AutoCAD install. Private=false so these are NOT copied
         into our output folder: AutoCAD supplies these assemblies itself at runtime, and a
         duplicate copy sitting next to the plugin DLL would cause type-identity conflicts. -->
    <Reference Include="accoremgd">
      <HintPath>$(AutoCadInstallDir)accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCadInstallDir)acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
